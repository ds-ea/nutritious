DATABASE_URL=

# Nx 18 enables using plugins to infer targets by default
# This is disabled for existing workspaces to maintain compatibility
# For more info, see: https://nx.dev/concepts/inferred-tasks
NX_ADD_PLUGINS=false

API_URL=
VITE_API_URL=$API_URL
VITE_PROJECT_NAME=Nutritious

QR_CODE_HASH=
VITE_QR_CODE_HASH=$QR_CODE_HASH

# ---------------------------------------------------------------------------
# apps/app build-time config.
# These are baked into the bundle by apps/app/webpack.config.js (DefinePlugin)
# and read by ConfigService. They must be exported in the shell that runs the
# build - a missing NX_API_URL produces an app that cannot reach the API.
# See docs/mobile-release.md.
# ---------------------------------------------------------------------------
NX_API_URL=$API_URL
NX_QR_CODE_HASH=$QR_CODE_HASH
NX_DEPLOYMENT_ENV=development
NX_PROJECT_NAME=Nutritious
NX_PRIVACY_URL=
NX_SUPPORT_URL=
# Do NOT set NX_APP_VERSION or NX_APP_BUILD here. They come from
# apps/app/.buildversion.json, which `nx run app:version-bump` writes, and setting them in the
# environment fails the build - Nx loads this file automatically, so a stale value here would
# otherwise mislabel a release. Override deliberately with NX_APP_ALLOW_ENV_VERSION=1.
