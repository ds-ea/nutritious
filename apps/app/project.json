{
	"name": "app",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "nutritious",
	"sourceRoot": "apps/app/src",
	"tags": [],
	"implicitDependencies": [
		"core"
	],
	"targets": {
		"build": {
			"executor": "@nx/angular:webpack-browser",
			"outputs": [
				"{options.outputPath}"
			],
			"options": {
				"outputPath": "dist/apps/app",
				"index": "apps/app/src/index.html",
				"main": "apps/app/src/main.ts",
				"polyfills": [
					"zone.js"
				],
				"tsConfig": "apps/app/tsconfig.app.json",
				"assets": [
					"apps/app/src/favicon.ico",
					"apps/app/src/assets",
					{
						"glob": "app.config.json",
						"input": "apps/app",
						"output": "./"
					},
					{
						"glob": "**/*.svg",
						"input": "node_modules/ionicons/dist/ionicons/svg",
						"output": "./svg"
					}
				],
				"styles": [
					"apps/app/src/theme/app.scss"
				],
				"scripts": [],
				"allowedCommonJsDependencies": [
					"fuzzysort",
					"localforage",
					"localforage-cordovasqlitedriver",
					"dayjs"
				],
				"customWebpackConfig": {
					"path": "apps/app/webpack.config.js"
				}
			},
			"configurations": {
				"development": {
					"buildOptimizer": false,
					"optimization": false,
					"vendorChunk": true,
					"extractLicenses": false,
					"sourceMap": true,
					"namedChunks": true
				},
				"production": {
					"baseHref": "/app/",
					"deployUrl": "/app/",
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "3mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "2kb",
							"maximumError": "4kb"
						}
					],
					"outputHashing": "all",
					"fileReplacements": [
						{
							"replace": "apps/app/src/environments/environment.ts",
							"with": "apps/app/src/environments/environment.prod.ts"
						}
					]
				},
				"production-mobile": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "3mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "2kb",
							"maximumError": "4kb"
						}
					],
					"outputHashing": "all",
					"fileReplacements": [
						{
							"replace": "apps/app/src/environments/environment.ts",
							"with": "apps/app/src/environments/environment.prod.ts"
						}
					]
				}
			},
			"defaultConfiguration": "production",
			"inputs": [
				"production",
				"^production",
				"{projectRoot}/.buildversion.json"
			],
			"dependsOn": [
				"^build"
			]
		},
		"build-release": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"nx run app:version-bump",
					"nx run app:build:production-mobile"
				],
				"parallel": false
			}
		},
		"serve": {
			"executor": "@nx/angular:dev-server",
			"configurations": {
				"development": {
					"buildTarget": "app:build:development"
				},
				"production": {
					"buildTarget": "app:build:production"
				}
			},
			"defaultConfiguration": "development",
			"continuous": true
		},
		"extract-i18n": {
			"executor": "@angular-devkit/build-angular:extract-i18n",
			"options": {
				"buildTarget": "app:build"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint",
			"outputs": [
				"{options.outputFile}"
			]
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": [
				"{workspaceRoot}/coverage/{projectRoot}"
			],
			"options": {
				"jestConfig": "apps/app/jest.config.ts"
			}
		},
		"cap": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/app",
				"command": "node ../../node_modules/@capacitor/cli/bin/capacitor",
				"forwardAllArgs": true
			}
		},
		"add": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/app",
				"command": "node ../../node_modules/@capacitor/cli/bin/capacitor add"
			},
			"configurations": {
				"ios": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor add ios"
				},
				"android": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor add android"
				}
			}
		},
		"copy": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/app",
				"command": "node ../../node_modules/@capacitor/cli/bin/capacitor copy"
			},
			"configurations": {
				"ios": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor copy ios"
				},
				"android": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor copy android"
				}
			}
		},
		"open": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/app",
				"command": "node ../../node_modules/@capacitor/cli/bin/capacitor open"
			},
			"configurations": {
				"ios": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor open ios"
				},
				"android": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor open android"
				}
			}
		},
		"run": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/app",
				"command": "node ../../node_modules/@capacitor/cli/bin/capacitor run"
			},
			"configurations": {
				"ios": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor run ios"
				},
				"android": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor run android"
				}
			}
		},
		"sync": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/app",
				"command": "node ../../node_modules/@capacitor/cli/bin/capacitor sync"
			},
			"configurations": {
				"ios": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor sync ios"
				},
				"android": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor sync android"
				}
			}
		},
		"update": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/app",
				"command": "node ../../node_modules/@capacitor/cli/bin/capacitor update"
			},
			"configurations": {
				"ios": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor update ios"
				},
				"android": {
					"command": "node ../../node_modules/@capacitor/cli/bin/capacitor update android"
				}
			}
		},
		"version-bump": {
			"executor": "nx:run-commands",
			"options": {
				"command": "{projectRoot}/versionbump.ts ."
			}
		}
	}
}
